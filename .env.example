# GEMINI_API_KEY: Required for Gemini AI structured reasoning, RFQ generation, response extraction, and risk explanation.
GEMINI_API_KEY=

# DATABASE_URL: SQLite connection string for development persistence.
DATABASE_URL=sqlite:///./vendra.db

# BACKEND_PORT: Configured Python backend port (falls back to 8001 if 8000 is reserved by container control plane).
BACKEND_PORT=8001

# JWT_SECRET_KEY: Server-side secret key for signing authentication tokens (never expose to frontend).
JWT_SECRET_KEY=

# NEWS_API_KEY: Optional market signals key for Opportunity Radar.
NEWS_API_KEY=

# ELEVENLABS_API_KEY: Optional voice synthesis and command feedback key.
ELEVENLABS_API_KEY=

# N8N_BASE_URL & N8N_WEBHOOK_SECRET: External orchestration and webhook verification.
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# RENDER_API_KEY: Long-running workflow execution and retry management.
RENDER_API_KEY=

# DODO_API_KEY: Optional settlement / PO escrow integration.
DODO_API_KEY=

# APP_URL: Self-referential application URL.
APP_URL=http://localhost:3000
